APP_ENV=local
HTTP_PORT=8080
DB_PATH=./backend/data/energy.db
FRONTEND_DIR=./frontend/out

# mode
# Safety defaults. Keep these values for mock/simulation startup.
MOCK_MODE=true
SIMULATION_MODE=true
ENABLE_REAL_CONTROL=false
AUTO_CONTROL_ENABLED=false
# Manual one-shot EcoFlow write requires this exact confirmation value.
CONFIRM_ECOFLOW_WRITE=
# Real auto-control trial is disabled unless one of these is set explicitly.
# Prefer REAL_CONTROL_TRIAL_UNTIL for long-running operation because it does not reset on restart.
# Example: REAL_CONTROL_TRIAL_UNTIL=YYYY-MM-DDTHH:MM:SS+09:00
REAL_CONTROL_TRIAL_MINUTES=0
REAL_CONTROL_TRIAL_UNTIL=

# Nature Remo
# Leave credentials empty for mock + simulation mode.
NATURE_MODE=cloud
NATURE_ACCESS_TOKEN=
NATURE_APPLIANCE_ID=
NATURE_LOCAL_BASE_URL=http://remo-e.local

# EcoFlow
# Developer API host depends on the issued key region. This project uses api-e by default.
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# DELTA Pro 3 SN is primarily managed in the charging device master.
# This value remains only as a read fallback and for one-shot CLI checks; auto write does not fall back to it.
ECOFLOW_DEVICE_SN=
ECOFLOW_BASE_URL=https://api-e.ecoflow.com

# Optional DELTA_3 series private MQTT/protobuf probe.
# This is separate from the official Developer API credentials above.
ECOFLOW_DELTA3_READ_ENABLED=false
ECOFLOW_PRIVATE_API_HOST=api.ecoflow.com
ECOFLOW_PRIVATE_EMAIL=
ECOFLOW_PRIVATE_PASSWORD=
# DELTA 3 Plus SN/type are managed in the charging device master.
# Use ecoflow-delta3-probe --sn/--device-type for one-shot CLI checks.
ECOFLOW_DELTA3_MQTT_CLIENT_ID=
ECOFLOW_DELTA3_TIMEOUT_SEC=20
ECOFLOW_DELTA3_ALLOW_WRITE_WITH_AUTO_CONTROL=false
ECOFLOW_DELTA3_EXECUTE=false
ECOFLOW_DELTA3_ALLOW_PRIVATE_API_WRITE=false

# DELTA 3 Plus auxiliary surplus charging.
# Disabled by default. These settings only create write candidates when every real-control gate is enabled.
DELTA3_AUX_ENABLED=false
DELTA3_AUX_MIN_CHARGE_W=100
DELTA3_AUX_MAX_CHARGE_W=1500
DELTA3_AUX_SAFETY_MARGIN_W=50
DELTA3_AUX_MIN_COMMAND_DIFF_W=100
DELTA3_AUX_MAX_INCREASE_STEP_W=300
DELTA3_AUX_MAX_DECREASE_STEP_W=500
DELTA3_AUX_MIN_COMMAND_INTERVAL_SEC=120
DELTA3_AUX_STOP_IMPORT_THRESHOLD_W=50
DELTA3_AUX_TARGET_MAX_SOC_BUFFER_PERCENT=2

# Weather forecast
# Open-Meteo Forecast API. Set latitude/longitude for the PV installation location.
WEATHER_FORECAST_ENABLED=false
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=Asia/Tokyo
WEATHER_BASE_URL=https://api.open-meteo.com

# control settings
# Control settings used by dry-run and real-control planners.
POLL_INTERVAL_SEC=30
START_EXPORT_THRESHOLD_W=700
STOP_EXPORT_THRESHOLD_W=300
SAFETY_MARGIN_W=150
MIN_CHARGE_W=400
MAX_CHARGE_W=1500
TARGET_SOC=90
MIN_COMMAND_INTERVAL_SEC=60
MIN_COMMAND_DIFF_W=100
EFFECTIVE_CHARGE_THRESHOLD_W=100
TARGET_EXPORT_BUFFER_W=150
MAX_INCREASE_STEP_W=400
MAX_DECREASE_STEP_W=600
RESERVE_RAISE_STEP_PERCENT=2
DEFAULT_RESERVE_SOC=30
PASS_THROUGH_ENABLED=false
PASS_THROUGH_COOLDOWN_SEC=300
REQUIRE_CONSECUTIVE_EXPORT_COUNT=2
REQUIRE_CONSECUTIVE_IMPORT_COUNT=2

# notifications
# Optional read-only alert for manually charging another battery when surplus export remains high
# and EcoFlow cannot absorb more because AC input is already maxed or SOC is high.
NOTIFICATION_ENABLED=false
NOTIFICATION_PROVIDER=slack
SLACK_WEBHOOK_URL=
MANUAL_CHARGE_ALERT_EXPORT_W=700
MANUAL_CHARGE_ALERT_SOC=95
MANUAL_CHARGE_ALERT_CONSECUTIVE=3
MANUAL_CHARGE_ALERT_COOLDOWN_MINUTES=30
