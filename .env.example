APP_ENV=local
HTTP_PORT=8080
DB_PATH=./backend/data/energy.db
FRONTEND_DIR=./frontend/out

# mode
# Safety defaults. Do not enable real EcoFlow control in Phase 1.
MOCK_MODE=true
SIMULATION_MODE=true
ENABLE_REAL_CONTROL=false
AUTO_CONTROL_ENABLED=false
# Manual one-shot EcoFlow write requires this exact confirmation value.
CONFIRM_ECOFLOW_WRITE=

# Nature Remo
# Future phases only. Leave empty for mock + simulation mode.
NATURE_MODE=cloud
NATURE_ACCESS_TOKEN=
NATURE_APPLIANCE_ID=
NATURE_LOCAL_BASE_URL=http://remo-e.local

# EcoFlow
# Developer API host depends on the issued key region. This project uses api-e by default.
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
ECOFLOW_DEVICE_SN=
ECOFLOW_BASE_URL=https://api-e.ecoflow.com

# Weather forecast
# Open-Meteo Forecast API. Set latitude/longitude for the PV installation location.
WEATHER_FORECAST_ENABLED=false
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=Asia/Tokyo
WEATHER_BASE_URL=https://api.open-meteo.com

# control settings
# Phase 2+ will read these values. Phase 1 keeps mock + simulation only.
POLL_INTERVAL_SEC=30
START_EXPORT_THRESHOLD_W=700
STOP_EXPORT_THRESHOLD_W=300
SAFETY_MARGIN_W=150
MIN_CHARGE_W=400
MAX_CHARGE_W=1500
TARGET_SOC=90
MIN_COMMAND_INTERVAL_SEC=60
MIN_COMMAND_DIFF_W=100
REQUIRE_CONSECUTIVE_EXPORT_COUNT=2
REQUIRE_CONSECUTIVE_IMPORT_COUNT=2
